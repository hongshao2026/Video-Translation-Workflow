{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dub-workbench.local/schemas/workflow_lock.schema.json",
  "title": "Workflow lock",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "required_documents",
    "current_stage",
    "next_gate",
    "execution_mode",
    "model_progress_polling",
    "document_loading",
    "agent_handoff",
    "media_format_selection",
    "ad_policy",
    "translation_mode",
    "translation_review",
    "chapter_reading_review",
    "chapter_reading_layout",
    "translation_approval",
    "chinese_tts_speed",
    "sync_strategy",
    "preserve_all_formal_working_master_frames",
    "audition_authorization",
    "full_tts_authorization",
    "publication_package",
    "publication_text_format",
    "cover_variants"
  ],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "status": {"const": "pass"},
    "required_documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "current_stage": {"type": "string", "minLength": 1},
    "next_gate": {"type": "string", "minLength": 1},
    "execution_mode": {"const": "local_runner_event_driven"},
    "model_progress_polling": {"const": "forbidden"},
    "document_loading": {"const": "first_load_then_hash_check_in_retained_context"},
    "agent_handoff": {"const": "minimal_frozen_role_packet"},
    "media_format_selection": {"const": "automatic_after_probe"},
    "ad_policy": {"const": "detect_then_apply_evidence_based"},
    "translation_mode": {"const": "provider_agent_direct_quality_first"},
    "translation_review": {"const": "two_independent_agents_full_coverage"},
    "chapter_reading_review": {"const": "required_before_translation_gate"},
    "chapter_reading_layout": {"const": "sentence_aligned_verbatim"},
    "translation_approval": {"const": "explicit_downstream_command_binds_current_version"},
    "chinese_tts_speed": {"const": 1.0},
    "sync_strategy": {"const": "video_retime_only"},
    "preserve_all_formal_working_master_frames": {"const": true},
    "audition_authorization": {"const": "voice_selection_implies_audition"},
    "full_tts_authorization": {"const": "user_generate_full_command"},
    "publication_package": {"const": "required_after_final_machine_qa"},
    "publication_text_format": {"const": "utf8_txt_only"},
    "cover_variants": {"const": "16x9_and_4x3"}
  }
}
