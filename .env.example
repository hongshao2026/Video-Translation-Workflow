# Copy only the names you need into your device's secret manager or process
# environment. This file is documentation and is not loaded automatically.

# Device-local project binding. The referenced JSON stays outside Git.
DUB_PROJECT_CONFIG=
DUB_WORKBENCH_LIBRARY_DIR=
DUB_WORKBENCH_STATE_DIR=
DUB_WORKBENCH_DB=
DUB_WORKER_ID=
# Default is the operating-system keyring. Use memory only for an explicit
# disposable session; credentials then disappear when the backend exits.
DUB_CREDENTIAL_BACKEND=

# Optional explicit Python executable. Leave empty to use .venv or PATH.
DUB_WORKBENCH_PYTHON=

# Provider credentials. Never commit real values.
OPENAI_API_KEY=
MINIMAX_API_KEY=

# Optional local model/tool bindings.
DUB_QWEN_MODEL_DIR=
DUB_KOKORO_MODEL_DIR=
DUB_COSYVOICE_MODEL_DIR=
DUB_COSYVOICE_REPO_DIR=
DUB_QWEN_PYTHON=
DUB_KOKORO_PYTHON=
DUB_COSYVOICE_PYTHON=
